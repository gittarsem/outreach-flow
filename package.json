{
  "name": "outreachflow",
  "version": "1.0.0",
  "private": true,
  "author": "OutreachFlow",
  "description": "Local-first Gmail job outreach desktop app",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on http://127.0.0.1:5173 dist/main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && vite build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac dmg",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "date-holidays": "^3.39.1",
    "exceljs": "^4.4.0",
    "googleapis": "^189.0.0",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "wasm-feature-detect": "1.8.0"
  }
}
